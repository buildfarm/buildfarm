{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":approveMajorUpdates",
    ":label(dependencies)",
    ":semanticCommitType(chore)",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "groupName": "Bazel",
      "matchPackageNames": [
        "bazel"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "groupName": "tini",
      "description": "tini x86_64 and arm64v8",
      "matchPackageNames": [
        "tini*"
      ]
    },
    {
      "groupName": "rules_proto",
      "description": "disable rules_proto as it's transitive and Buildfarm does not use it",
      "matchPackageNames": [
        "rules_proto"
      ],
      "enabled": false
    },
    {
      "description": "disable helm-values",
      "matchManagers": ["helm-values"],
      "enabled": false
    },
    {
      "description": "Maven lockfile is re-pinned on renovate/** by .github/workflows/renovate-pin-maven.yml after MODULE.bazel changes",
      "matchManagers": ["bazel-module"],
      "matchDatasources": ["maven"],
      "dependencyDashboardApproval": true,
      "automerge": true,
      "prConcurrentLimit": 1,
      "rebaseWhen": "never"
    },
    {
      "groupName": "jnr",
      "description": "Bundle jnr dependency updates into one PR",
      "matchPackageNames": [
        "com.github.jnr:jffi",
        "com.github.jnr:jnr-ffi",
        "com.github.jnr:jnr-posix"
      ]
    },
    {
      "groupName": "Apache commons",
      "description": "All apache commons grouped into one PR",
      "matchPackageNames": [
        "commons-io:commons-io",
        "org.apache.commons:*"
      ]
    },
    {
      "groupName": "Java protobuf",
      "description": "Java protobuf and common protos",
      "matchPackageNames": [
        "com.google.api.grpc:proto-google-common-protos",
        "com.google.protobuf:*"
      ]
    },
    {
      "groupName": "annotations",
      "matchPackageNames": [
        "com.google.errorprone:*",
        "net.jcip:jcip-annotations",
        "org.checkerframework:checker-qual",
        "org.jetbrains:annotations",
        "org.jspecify:jspecify"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "extends": ["schedule:monthly"],
      "automerge": true
    },
    {
      "description": "Bazel Central Registry updates",
      "matchManagers": [
        "bazel-module"
      ],
      "matchDatasources": ["bazel"],
      "extends": ["schedule:weekly"],
      "automerge": true
    }
  ]
}
